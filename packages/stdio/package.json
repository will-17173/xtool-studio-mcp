{
  "name": "xtool-studio-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "Local MCP server for xTool Studio on Windows, with xTool knowledge and XS/XCS project tools.",
  "license": "MIT",
  "bin": {
    "xtool-studio-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "xtool",
    "laser",
    "mcp",
    "model-context-protocol",
    "stdio"
  ],
  "scripts": {
    "test": "tsx --test test/projects.test.ts",
    "build": "tsup",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@xtool-mcp/core": "workspace:*",
    "fflate": "^0.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
